from pysimverse import Drone
import time

#  create an instance of drone
drone = Drone()
drone.connect()
drone.take_off()
drone.set_speed(500)
#distance in cm

drone.move_forward(350)

drone.move_left(240)
time.sleep(1)

drone.move_backward(160)

drone.move_right(250)
drone.move_down(100)
drone.move_right(330)
time.sleep(1)

drone.land()